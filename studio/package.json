{
  "name": "photosite-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "sanity dev",
    "typecheck": "tsc --noEmit",
    "schema:validate": "sanity schemas validate --level error",
    "build": "sanity build --yes && node ../scripts/write-studio-notices.mts",
    "deploy": "npm run build && sanity deploy --no-build --schema-required"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@sanity/image-url": "2.1.1",
    "@sanity/locale-fi-fi": "1.1.40",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.18.0",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@types/node": "24.10.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "braces": "file:../vendor/braces-3.0.4-photosite.1.tgz"
  },
  "overrides": {
    "braces": "$braces",
    "js-yaml@3.13.1": "3.15.2",
    "smol-toml@1.5.2": "1.9.1",
    "uuid@10.0.0": "11.1.1"
  }
}
