{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["*.ts", "*.tsx", "../sanity/schemas/**/*.ts"],
  "exclude": ["node_modules", "dist", "../sanity/**/*.test.ts", "*.test.ts"]
}
