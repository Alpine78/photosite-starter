# Public configuration only: every SANITY_STUDIO_* value enters browser JavaScript.
# Match the site's SANITY_PROJECT_ID, SANITY_DATASET, and SANITY_DATASET_VISIBILITY.
SANITY_STUDIO_PROJECT_ID=example1
SANITY_STUDIO_DATASET=example
SANITY_STUDIO_DATASET_VISIBILITY=public
SANITY_STUDIO_TITLE="PhotoSite Studio"
# Copy the site's complete SITE_LOCALE_ROUTES, including its optional service and search namespaces.
SANITY_STUDIO_LOCALE_ROUTES="fi||tarinat|palvelut|haku,en-GB|en|stories|services|search"
# Optional, selected when publishing. No API token belongs in this file.
# SANITY_STUDIO_HOSTNAME=your-studio-name
# After the first deployment, copy its application ID here for subsequent updates.
# SANITY_STUDIO_APP_ID=your-deployed-application-id
