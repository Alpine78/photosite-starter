# Line-ending normalization, enforced by the repository rather than left to each
# machine's core.autocrlf setting. Objects are stored as LF; Windows working
# copies still get CRLF on checkout.
* text=auto

# Vendored third-party text is stored byte-identical to its upstream source, so
# provenance can be verified with a plain diff (see docs/asset-inventory.md).
# Note that a Windows *working copy* is still CRLF — normalize before diffing.
licenses/**            text eol=lf
.claude/skills/**      text eol=lf
.agents/skills/**      text eol=lf

# Architecture diagrams. `npm run diagrams:check` compares the committed SVG
# byte-for-byte against a fresh render, and the renderer always emits LF. A
# CRLF working copy would fail that comparison on Windows and pass on Linux,
# so both the authoritative source and the generated rendition are checked out
# exactly as they are stored.
docs/architecture/*.d2   text eol=lf
docs/architecture/*.svg  text eol=lf
