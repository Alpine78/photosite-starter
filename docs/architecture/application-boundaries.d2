# Application and data boundaries: what a request passes through, and where
# provider knowledge and secrets are not allowed to travel.
#
# Purpose: show the layers a request crosses, and the one crossing that is
# enforced by tooling rather than by convention — src/app and src/components
# cannot import the server-only modules at all, and src/lib is the only layer
# that may. That rule is invisible when reading any single file, which is why
# it is drawn.
#
# Deliberately not shown: individual components, every module in src/lib, and
# the shape of any data. This is a boundary map, not a file listing.
#
# Layout notes for whoever edits this next: `direction` inside a container is
# ignored by the pinned D2 build, but `grid-columns` is not, so each layer is a
# single-row grid. Edges run between layers rather than into a layer's
# children — a handful of edges into grid cells is what turned an earlier draft
# of this diagram into a knot.

...@_shared

direction: down

browser: "Visitor's browser" {
  class: built
}

proxy: "src/proxy.ts — the Proxy (ADR-0007)\nCopies the requested path and a single \"a cursor was present\" bit into project-owned\nheaders, overwriting anything the client sent, so a not-found boundary that App Router\ngives no props can still name a way back. Owns trailing-slash normalization, so a cursor\nis validated before a 308. Optional default-off maintenance gate (ADR-0031):503 before\ncontent/API work; actual static files pass, missing candidates use a content-free\nafterFiles fallback. No query values, no content reads, no secrets." {
  class: built
}

routes: "src/app — App Router" {
  class: built
  grid-columns: 4

  static: "Static routes\nBUILT: locale-owned home/contact (AB#255; available authored copy only),\nplus locale-owned service namespaces\nwith nested service details, e.g. /palvelut and /en/services.\nThe former /services routes remain only as pre-launch compatibility routes." {
    class: built
  }

  tree: "[localePrefix]/[[...segments]]\nThe locale-aware content tree:\ncategory branches, articles,\ncurated galleries" {
    class: built
  }

  api: "Route handlers\napi/contact, api/enquiry — same-origin JSON,\nclosed field whitelist, shared abuse + delivery path\napi/gallery, api/article-gallery — one bounded slice\napi/poll-vote — fresh results, protected preparation,\nsame-origin bounded JSON voting" {
    class: built
  }

  reserved: "Reserved namespaces (protected gallery removed — AB#313)\nNo routes: the Proxy answers every path and method under the\nconfigured customer and administrator prefixes and the literal\n/private-gallery and /private-gallery-admin segments with one\nempty 404 (no-store, noindex/nofollow, no-referrer);\nrobots Disallow. Prefixes stay validated and reserved." {
    class: built
  }

  unlisted: "Unlisted client delivery (selected — ADR-0034)\n/client-gallery/<handle>; no customer login.\n21 legacy pages observed live 2026-10-15.\nPublic Sanity metadata/files. Page: noindex, no-store.\nNew authoring + customer reader built, default-off.\nNative Studio roles; optional verified public whole ZIP.\nProof selection + reviewed replacement deletion built, default-off.\nDelivery cleanup GET: cron bearer, counts only; source-built, off." {
    class: built
  }
}

components: "src/components" {
  class: built
  grid-columns: 2

  server-components: "Server components\nBreadcrumbs, listings, gallery grid,\nmedia figures, site navigation, public poll results" {
    class: built
  }

  client-components: "Client components\nLightbox (+ item-enquiry link), submission form\n(contact / gallery enquiry), poll voting, in-place gallery append" {
    class: built
  }
}

lib: "src/lib — domain contracts, data-access seams, and fixtures" {
  class: built
  grid-columns: 4

  config: "Deployment configuration\ndeployment-config, deployment-stage,\nlocale-routes, site-settings" {
    class: built
  }

  domain: "Domain and result contracts\ncontent-tree, content-page, media,\nimage-delivery, gallery-result, gallery-slice,\ngallery-pagination, article-end-gallery-pagination, keyset-cursor" {
    class: built
  }

  seams: "Data-access seams\ncontent.ts, gallery.ts, article-end-gallery.ts,\ncontact-delivery.ts, poll-vote-access.ts\nSwapping the store changes only these" {
    class: built
  }

  fixtures: "Mock fixtures\nmock-content-tree, mock-gallery,\nmock-media\nSITE_CONTENT_SOURCE=mock" {
    class: [store; built]
  }
}

restricted: "Server-only modules" {
  class: built
  grid-columns: 2

  sanity-config: "sanity-config.ts\nValidated connection settings,\nthe optional read token,\nand the asset CDN address" {
    class: built
  }

  sanity-client: "sanity-client.ts\nContent Lake HTTP API,\npublished perspective only" {
    class: built
  }

  sanity-media: "sanity-media.ts\nAllow-list projection of the shared\nmedia document; no seam reads it yet" {
    class: built
  }

  sanity-content-tree: "sanity-content-tree.ts\nProjects category documents into\ncontent-tree.ts input; no seam reads it yet" {
    class: built
  }

  sanity-site: "sanity-site-settings.ts and\nsanity-home-content.ts\nProject published singletons; no seam reads them yet" {
    class: built
  }

  continuation-cursors: "gallery-cursor.ts / content-listing-cursor.ts\nShared GALLERY_CURSOR_SIGNING_KEY,\nresolved lazily (gallery and category-branch\ncontinuation, ADR-0013)" {
    class: built
  }

  poll-vote: "poll-vote-access.ts -> poll-vote-sanity.ts (ADR-0018)\nFresh, validated public poll reads; separate runtime write token;\none atomic receipt-create + tally-increment transaction.\nRoutes/components cannot import the raw Sanity writes." {
    class: built
  }

  enquiry-media: "enquiry-media.ts (+ mock-enquiry-media.ts / sanity-enquiry-media.ts)\nServer-only itemId -> mediaId resolution for the AB#60 enquiry flow.\nAuthorizes the container against the public content tree, then resolves\nand validates the private archiveLocator. api/enquiry consumes it and puts\nthe archiveLocator only in the owner's email — never a response or a log." {
    class: built
  }

  delivery-cleanup: "Delivery cleanup facade -> worker -> dedicated Sanity transport (AB#397–398)\nSOURCE BUILT, DEFAULT OFF; hosted role/deletion acceptance pending.\nOne full-readable snapshot + strict Doc reads; retain reference metadata only.\nPrivate control/cursor fence, fresh policy/revision guards; atomic gallery + images + optional ZIP.\nShared images/ZIPs kept; closed ZIP counts. Late weak/release writers remain an activation boundary.\nPublic projection and proof/legacy timers unchanged." {
    class: built
  }
}

external: "Outside the deployment" {
  class: external
  grid-columns: 2

  sanity: "Sanity Content Lake\nMedia, category, settings, and home\nschemas/adapters exist; no page reads them yet" {
    class: [store; planned]
  }

  delivery: "Resend HTTP API\nOr the sink adapter, which a\nproduction deployment refuses to build" {
    class: external
  }
}

browser -> proxy: Every matched request
proxy -> routes: "Request, plus two bounded headers"
routes -> components: Renders
routes -> lib: "Resolves configuration and routes,\nreads one bounded result per page"
components -> lib: "Reads contracts and per-locale labels"

lib -> restricted: "The only crossing there is.\nESLint refuses these imports from src/app and src/components, and the\nserver-only marker fails the build on the indirect case ESLint cannot see." {
  style.stroke-width: 3
  style.bold: true
}

restricted -> external: "Published/unlisted Sanity reads; default-off delivery cleanup\nuses full dataset READ; reference Editor WRITE risk accepted (ADR-0040),\nhosted verification pending; off by default.\nAtomic public poll writes through the separate voting token" {class: pending-flow}
lib -> external: "Delivers one enquiry.\nNo form content is stored anywhere."
