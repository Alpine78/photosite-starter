# System context: the systems around the site, who owns each, and which of
# those conversations actually happen today.
#
# Purpose: show every system outside this repository that a deployed clone
# depends on, and the ownership boundary around each — because "the site owner
# owns their own CMS, mailbox, and hosting account" is the product decision
# ADR-0004 and ADR-0006 turn on, and it is invisible in the code.
#
# Deliberately not shown: anything inside the application (that is
# application-boundaries.d2) and the pipeline's steps (deployment-flow.d2).
# This is context level — the pipeline appears here as one box, because who
# owns it is the point, not what it runs.
#
# Layout note: `direction` inside a container has no effect in the pinned D2
# build, so every node here is a leaf and the picture is kept flat. A label
# carrying `\n` on a leaf is a multi-line label; the same label on a container
# becomes an oversized title above the box, which is why containers here keep
# one-word names.

...@_shared

direction: down

visitor: Visitor {
  shape: person
  class: built
}

owner: "Site owner\n(the photographer)" {
  shape: person
  class: built
}

repo: "GitHub\nPublic source repository" {
  class: external
}

pipeline: "Azure DevOps\nBoards, and Pipelines that\nlint, test, build, and gate" {
  class: external
}

vercel: "Vercel\nHosting in the site owner's\nown team — ADR-0004" {
  class: external
}

site: "PhotoSite Starter\nNext.js App Router, server-rendered.\nPublic pages only: no visitor accounts,\nno tracking cookies, no cookie banner." {
  class: built
}

fixtures: "Mock content\nDemo fixtures in src/lib.\nRefused in a production deployment." {
  class: [store; built]
}

sanity: "Sanity Content Lake\nThe site owner's own project\nand dataset — ADR-0006" {
  class: [store; external]
}

studio: "Optional standalone Studio — AB#254\nstudio/ imports canonical schemas;\nseparate build, Sanity-session login.\nHosted publication/login redirect checked;\nauthenticated editing unverified." {
  class: built
}

resend: "Resend\nContact delivery from the site\nowner's own account — ADR-0004 §5" {
  class: external
}

private-store: "Private object store (deferred — ADR-0034)\nS3-compatible, the site owner's own account,\nseparate from Sanity — client-gallery previews,\nwatermarked proofs, and one ZIP per delivery gallery" {
  class: [store; planned]
}

private-db: "Private Postgres (deferred — ADR-0034)\nThe site owner's own database — private gallery\nrecords, access capabilities, sessions, proof\nselections, notification outbox, retention state" {
  class: [store; planned]
}

unlisted: "Unlisted client delivery (selected — ADR-0034)\nExisting Sanity; public metadata and files.\n21 legacy pages observed live 2026-10-15;\nnew-gallery authoring still to implement.\nPage expiry does not revoke files." {
  class: built
}

visitor -> unlisted: "Direct unlisted link, no customer login"
unlisted -> sanity: "Fresh publication / deadline / manifest reads"
visitor -> sanity: "Public JPEG / ZIP URLs in legacy page markup;\nfile downloads / integrity verification pending.\nNew batches require their own review." {class: pending-flow}

visitor -> site: "Reads pages,\nbrowses galleries"
visitor -> site: Sends an enquiry

owner -> repo: Commits
owner -> studio: "Edits content with a Sanity account\n(authenticated workflow unverified)" {class: pending-flow}
studio -> sanity: "Authenticated editor reads/writes\n(authenticated workflow unverified)" {class: pending-flow}
owner -> site: "Administers client galleries\nthrough the protected model's admin route\n(deferred — ADR-0034)" {class: pending-flow}
owner -> private-store: "Private upload CLI (deferred alternative)" {class: pending-flow}

repo -> pipeline: Triggers every push and PR
pipeline -> vercel: "Deploys a release candidate\n(built and gated, never yet run)" {class: pending-flow}
vercel -> site: "Runs the site\n(not yet deployed)" {class: pending-flow}

site -> fixtures: SITE_CONTENT_SOURCE=mock
site -> sanity: "Reads published content\n(connection built, reads planned)" {class: pending-flow}
site -> resend: Delivers an enquiry over HTTPS
site -> private-store: "Signed GETs (deferred alternative)" {class: pending-flow}
site -> private-db: "Private metadata (deferred alternative)" {class: pending-flow}
visitor -> private-store: "Signed downloads (deferred alternative)" {class: pending-flow}
