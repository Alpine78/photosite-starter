# Which environment this deployment is: development, preview, or production.
# Unset means production, which is the fail-closed direction — safeguards that
# refuse a development shortcut stay on unless a deployment declares otherwise.
# A production clone can leave this unset or set it explicitly; both are safe.
SITE_DEPLOYMENT_STAGE=development

# Default locale: BCP 47 tag with a concrete language subtag, used by the root
# language attribute, date formatting, and the unprefixed public routes.
SITE_LOCALE=en-GB

# Public route space per supported locale: comma-separated
# "locale|prefix|namespace" entries. The default locale leaves the prefix empty,
# because its routes carry none, and must match SITE_LOCALE. Every other locale
# needs a unique prefix that no root route already owns. A story namespace may
# not shadow a localized static route. Each locale also needs a built-in label
# set in src/lib/deployment-config.ts. A single-locale clone drops every entry
# but its own; the first production deployment reads: fi||tarinat,en|en|stories
SITE_LOCALE_ROUTES=en-GB||stories,fi|fi|tarinat

# Public origin every canonical and Open Graph URL is built from. Bare origin
# only: no credentials, query, fragment, or path.
SITE_CANONICAL_BASE_URL=https://example.com

# Versioned public web derivative: a local /gallery path or an HTTPS URL. It
# crosses the same public media boundary as every other browser-facing image.
SITE_DEFAULT_SOCIAL_IMAGE=/gallery/coastal-landscape.1683eecb7e65.webp

# Byte version contained in SITE_DEFAULT_SOCIAL_IMAGE. Required only for a
# remote URL; a local /gallery path already carries it in the filename.
# SITE_DEFAULT_SOCIAL_IMAGE_VERSION=

# True intrinsic pixel dimensions of SITE_DEFAULT_SOCIAL_IMAGE. Nothing in the
# application can measure a deployment-owned file, so they are declared here.
SITE_DEFAULT_SOCIAL_IMAGE_WIDTH=1536
SITE_DEFAULT_SOCIAL_IMAGE_HEIGHT=1024

# Optional alt text for the default social image. Left unset, no og:image:alt is
# emitted rather than an invented description.
SITE_DEFAULT_SOCIAL_IMAGE_ALT=Rocky shoreline beside calm water under an overcast sky

# --- Contact form delivery (AB#12) -----------------------------------------
#
# Which delivery adapter the contact endpoint uses. There is no default: "sink"
# accepts a message and sends nothing (local development, CI, and the Preview
# environment), "resend" delivers over the Resend HTTP API. A deployment that
# leaves this unset serves the contact page and fails the submission with a
# configuration error rather than silently discarding enquiries.
#
# "sink" is refused outright when SITE_DEPLOYMENT_STAGE is production, so this
# value in a production delivery path becomes a safe configuration failure on
# the first attempted submission rather than silent loss reported as success.
CONTACT_DELIVERY_ADAPTER=sink

# Verified sender for the outbound message. Required by the "resend" adapter.
# The domain must be verified in the deployment's own delivery account.
# CONTACT_DELIVERY_FROM=Studio Example <contact@example.com>

# Mailbox that receives enquiries. Required by the "resend" adapter.
# CONTACT_DELIVERY_TO=hello@example.com

# Server-only credential for the "resend" adapter. Never prefixed NEXT_PUBLIC_,
# never placed in a URL, and different between Preview and Production.
# RESEND_API_KEY=

# --- Gallery continuation (AB#72) -------------------------------------------
#
# Signing key for the opaque continuation cursors a gallery larger than one page
# issues. Server-only and never prefixed NEXT_PUBLIC_ (that name is compiled
# into the browser bundle and is refused): a published key lets anyone mint
# cursors this deployment would accept. 32-256 printable ASCII characters.
#
# Unlike every SITE_* value above, this is read at request time rather than at
# build time, so a Preview or Production deployment stores it as a Sensitive
# variable — see docs/deployment.md. It is read lazily, only when a gallery
# actually needs a cursor, so the build never requires it — but the mock content
# source ships a gallery larger than one page, so in practice set it. Leaving it
# unset makes that gallery fail its request with an error naming this setting.
#
# It must be ONE STABLE VALUE per environment. Continuation URLs are indexable
# (ADR-0003 decision 8), and serverless instances do not share a process, so a
# value that changed per deploy or per instance would 404 cursors another
# instance had just issued. Rotating it deliberately retires every continuation
# URL already issued and indexed.
#
# The value below is a development placeholder and is not a secret.
GALLERY_CURSOR_SIGNING_KEY=development-only-gallery-cursor-signing-key

# --- Content source and Sanity (AB#39) --------------------------------------
#
# Which store this deployment's authored content comes from. There is no
# default: "mock" reads the project's own demo fixtures (placeholder copy and
# AI-generated placeholder photographs), "sanity" reads the deployment's own
# Content Lake. A deployment that declares neither fails with a configuration
# error naming this setting.
#
# "mock" is refused outright when SITE_DEPLOYMENT_STAGE is production, for the
# same reason the contact form's sink adapter is: publishing demo content as a
# photographer's own work is misrepresentation, not a mode.
SITE_CONTENT_SOURCE=mock

# The customer-owned Sanity project. Required by SITE_CONTENT_SOURCE=sanity and
# ignored otherwise. Your own organization, project, dataset, and billing —
# there is no shared account. See docs/sanity-setup.md.
#
# The project id is the hostname label in <projectId>.api.sanity.io.
# SANITY_PROJECT_ID=

# Dataset to read, e.g. "production". Preview and Production deployments should
# not share one.
# SANITY_DATASET=production

# Whether anyone may read this dataset's documents: "public" or "private". No
# default. Declared rather than discovered, because a private dataset read
# without a credential answers 200 and an empty result instead of an error — a
# site that looks unwritten rather than misconfigured. It is also the value the
# Studio schema is built with, where it decides whether an archive-location
# field exists at all.
# SANITY_DATASET_VISIBILITY=public

# Dated Content Lake API version, pinned so the API cannot change underneath a
# running site. Must be vYYYY-MM-DD; an undated or legacy version is refused.
# SANITY_API_VERSION=v2026-06-24

# Server-only read token. A public dataset needs none; a private one cannot be
# read without it, and declaring "private" without one fails the build. A local
# build and runtime can use this one setting. The reference deployment keeps
# two credentials instead: Azure's SANITY_BUILD_READ_TOKEN is mapped to this
# name only for the build, and Vercel injects a separate Sensitive value at
# runtime. See docs/deployment.md.
# Never prefixed NEXT_PUBLIC_ (that name is compiled into the browser
# bundle and is refused), never placed in a URL, and different between Preview
# and Production. Reads always use the published perspective, so a token widens
# which documents are readable — it never exposes drafts.
# SANITY_READ_TOKEN=

# Server-only secret shared only by this deployment and its Sanity document
# webhook. It signs the exact request body sent to POST /api/revalidate. Use one
# stable random value of at least 32 bytes per environment; Preview and
# Production must differ. It is read only at request time and belongs in
# Vercel's Sensitive variables, never under a NEXT_PUBLIC_ name.
# SANITY_WEBHOOK_SECRET=
