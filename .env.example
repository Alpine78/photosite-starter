# Which environment this deployment is: development, preview, or production.
# Unset means production, which is the fail-closed direction — safeguards that
# refuse a development shortcut stay on unless a deployment declares otherwise.
# A production clone can leave this unset or set it explicitly; both are safe.
SITE_DEPLOYMENT_STAGE=development

# Default locale: BCP 47 tag with a concrete language subtag, used by the root
# language attribute, date formatting, and the unprefixed public routes.
SITE_LOCALE=en-GB

# Public route space per supported locale: comma-separated
# "locale|prefix|namespace" entries. The default locale leaves the prefix empty,
# because its routes carry none, and must match SITE_LOCALE. Every other locale
# needs a unique prefix that no root route already owns. A story namespace may
# not shadow a localized static route. Each locale also needs a built-in label
# set in src/lib/deployment-config.ts. A single-locale clone drops every entry
# but its own. The optional fourth field is the locale's static service
# namespace and the optional fifth its site-search namespace (default `search`);
# the first production deployment reads:
# fi||tarinat|palvelut|haku,en-GB|en|stories|services|search
SITE_LOCALE_ROUTES=en-GB||stories|services,fi|fi|tarinat|services

# Public origin every canonical and Open Graph URL is built from. Bare origin
# only: no credentials, query, fragment, or path.
SITE_CANONICAL_BASE_URL=https://example.com

# Optional bare assigned *.vercel.app aliases to mark noindex on a Production
# Vercel build only. At most eight comma-separated hosts, never the canonical
# hostname. Unset preserves the default when a Vercel host IS the canonical site.
# This is crawl guidance, not access protection; changing it requires rebuilding.
# PRODUCTION_NOINDEX_ALIASES=example-project.vercel.app,example-project-team.vercel.app

# Versioned public web derivative: a local /gallery path or an HTTPS URL. It
# crosses the same public media boundary as every other browser-facing image.
SITE_DEFAULT_SOCIAL_IMAGE=/gallery/coastal-landscape.1683eecb7e65.webp

# Byte version contained in SITE_DEFAULT_SOCIAL_IMAGE. Required only for a
# remote URL; a local /gallery path already carries it in the filename.
# SITE_DEFAULT_SOCIAL_IMAGE_VERSION=

# True intrinsic pixel dimensions of SITE_DEFAULT_SOCIAL_IMAGE. Nothing in the
# application can measure a deployment-owned file, so they are declared here.
SITE_DEFAULT_SOCIAL_IMAGE_WIDTH=1536
SITE_DEFAULT_SOCIAL_IMAGE_HEIGHT=1024

# Optional alt text for the default social image. Left unset, no og:image:alt is
# emitted rather than an invented description.
SITE_DEFAULT_SOCIAL_IMAGE_ALT=Rocky shoreline beside calm water under an overcast sky

# Optional comma-separated crawler tokens that production robots.txt keeps off
# the whole site (letters, digits, "-", "_"). Unset names none. Guidance for
# well-behaved crawlers only, not access control.
# SITE_ROBOTS_DISALLOWED_AGENTS=SemrushBot,AhrefsBot,DotBot,MJ12bot

# Optional cookieless page-view statistics (ADR-0037, AB#371). Unset or `off`
# sends nothing. `vercel` loads Vercel Web Analytics on a Vercel deployment and
# is honored only when SITE_DEPLOYMENT_STAGE is production: development, Preview
# and the Playwright harness stay off even if the value is inherited. Any other
# value fails the build. Unlisted-gallery pages and the reserved private and
# administrator namespaces never report, and query strings and fragments are
# never sent. Read at build time, so changing it takes effect on the next build. Enable it in the Vercel dashboard
# as well; see docs/analytics-data-flow.md.
# SITE_ANALYTICS=vercel

# --- Contact form delivery (AB#12) -----------------------------------------
#
# Which delivery adapter the contact endpoint uses. There is no default: "sink"
# accepts a message and sends nothing (local development, CI, and the Preview
# environment), "resend" delivers over the Resend HTTP API. A deployment that
# leaves this unset serves the contact page and fails the submission with a
# configuration error rather than silently discarding enquiries.
#
# "sink" is refused outright when SITE_DEPLOYMENT_STAGE is production, so this
# value in a production delivery path becomes a safe configuration failure on
# the first attempted submission rather than silent loss reported as success.
CONTACT_DELIVERY_ADAPTER=sink

# Verified sender for the outbound message. Required by the "resend" adapter.
# The domain must be verified in the deployment's own delivery account.
# CONTACT_DELIVERY_FROM=Studio Example <contact@example.com>

# Mailbox that receives enquiries. Required by the "resend" adapter.
# CONTACT_DELIVERY_TO=hello@example.com

# Server-only credential for the "resend" adapter. Never prefixed NEXT_PUBLIC_,
# never placed in a URL, and different between Preview and Production.
# RESEND_API_KEY=

# --- Continuation cursors (AB#72, AB#140) ---------------------------------
#
# Signing key for the opaque continuation cursors this deployment issues: for a
# gallery larger than one page (AB#72), and for a category branch listing larger
# than one page (AB#140, ADR-0013). One shared secret for both — see ADR-0013.
# Server-only and never prefixed NEXT_PUBLIC_ (that name is compiled into the
# browser bundle and is refused): a published key lets anyone mint cursors this
# deployment would accept. 32-256 printable ASCII characters.
#
# Unlike every SITE_* value above, this is read at request time rather than at
# build time, so a Preview or Production deployment stores it as a Sensitive
# variable — see docs/deployment.md. It is read lazily, only when a gallery or a
# category branch actually needs a cursor, so the build never requires it — but
# the mock content source ships both a gallery and a category branch larger than
# one page, so in practice set it. Leaving it unset makes that page fail its
# request with an error naming this setting.
#
# It must be ONE STABLE VALUE per environment. Continuation URLs are indexable
# (ADR-0003 decision 8), and serverless instances do not share a process, so a
# value that changed per deploy or per instance would 404 cursors another
# instance had just issued. Rotating it deliberately retires every continuation
# URL already issued and indexed — gallery AND category-branch continuations.
#
# The value below is a development placeholder and is not a secret. A production
# deployment refuses it (AB#420), so set a generated value there.
GALLERY_CURSOR_SIGNING_KEY=development-only-gallery-cursor-signing-key

# --- Content source and Sanity (AB#39) --------------------------------------
#
# Which store this deployment's authored content comes from. There is no
# default: "mock" reads the project's own demo fixtures (placeholder copy and
# AI-generated placeholder photographs), "sanity" reads the deployment's own
# Content Lake. A deployment that declares neither fails with a configuration
# error naming this setting.
#
# "mock" is refused outright when SITE_DEPLOYMENT_STAGE is production, for the
# same reason the contact form's sink adapter is: publishing demo content as a
# photographer's own work is misrepresentation, not a mode.
SITE_CONTENT_SOURCE=mock

# Server-only application maintenance boundary (AB#341 / ADR-0031).
# Keep off normally. A separately approved deployment generation may use on;
# unknown nonempty values fail closed. Never define a NEXT_PUBLIC_ mirror.
# This does not revoke direct asset URLs or already delivered browser bytes.
# Actual hosted coverage/cache coherence must be verified before activation.
SITE_MAINTENANCE_MODE=off

# The customer-owned Sanity project. Required by SITE_CONTENT_SOURCE=sanity and
# ignored otherwise. Your own organization, project, dataset, and billing —
# there is no shared account. See docs/sanity-setup.md.
#
# The project id is the hostname label in <projectId>.api.sanity.io.
# SANITY_PROJECT_ID=

# Dataset to read, e.g. "production". Preview and Production deployments should
# not share one.
# SANITY_DATASET=production

# Whether anyone may read this dataset's documents: "public" or "private". No
# default. Declared rather than discovered, because a private dataset read
# without a credential answers 200 and an empty result instead of an error — a
# site that looks unwritten rather than misconfigured. It is also the value the
# Studio schema is built with, where it decides whether an archive-location
# field exists at all.
# SANITY_DATASET_VISIBILITY=public

# Dated Content Lake API version, pinned so the API cannot change underneath a
# running site. Must be vYYYY-MM-DD; an undated or legacy version is refused.
# SANITY_API_VERSION=v2026-06-24

# Server-only read token. A public dataset needs none; a private one cannot be
# read without it, and declaring "private" without one fails the build. A local
# build and runtime can use this one setting. The reference deployment keeps
# two credentials instead: Azure's SANITY_BUILD_READ_TOKEN is mapped to this
# name only for the build, and Vercel injects a separate Sensitive value at
# runtime. See docs/deployment.md.
# Never prefixed NEXT_PUBLIC_ (that name is compiled into the browser
# bundle and is refused), never placed in a URL, and different between Preview
# and Production. Reads always use the published perspective, so a token widens
# which documents are readable — it never exposes drafts.
# SANITY_READ_TOKEN=

# Server-only secret shared only by this deployment and its Sanity document
# webhook. It signs the exact request body sent to POST /api/revalidate. Use one
# stable random value of at least 32 bytes per environment; Preview and
# Production must differ. It is read only at request time and belongs in
# Vercel's Sensitive variables, never under a NEXT_PUBLIC_ name.
# SANITY_WEBHOOK_SECRET=

# --- Sample content seeding (AB#84) -----------------------------------------
#
# Write-scoped credential for `npm run seed:sanity -- --yes`, the owner-run
# script that writes this repository's sample fixtures into a Sanity dataset.
# NEVER the same value as SANITY_READ_TOKEN above: that one is the runtime
# app's read-only credential, baked into every deployment; this one can write,
# and belongs only on the machine (or one-off CI run) that seeds content, never
# in a deployed environment. Not read by the application itself — only by
# scripts/seed-sanity-content.mts. See docs/sanity-seeding.md.
# SANITY_SEED_TOKEN=

# --- Ongoing unlisted client galleries (AB#303, ADR-0034) ------------------
# Selected direction: existing Sanity, no S3/PostgreSQL or custom site login.
# Off by default; source implementation does not enable Production. "sanity"
# requires SITE_CONTENT_SOURCE=sanity, SANITY_DATASET_VISIBILITY=public and the
# other SANITY_* settings above; real reads
# are refused in Preview. "fixture" is local development/CI only.
# Public metadata and image URLs can be enumerated; this is not authentication.
# Native Studio publication + available=true + explicit deadline/indefinite mode
# control the page, not already-public files. See docs/deployment.md.
CLIENT_GALLERY_ADAPTER=off

# --- Scheduled delivery cleanup (AB#397–398) -----------------------------
# Source only; keep off until the separately authorized hosted rehearsal in
# docs/client-gallery-cleanup.md. Production Sanity delivery only, never Preview.
# Daily authenticated GET /api/client-gallery-cleanup; legacy/proofs excluded.
# An enrolled new delivery includes its optional verified whole ZIP.
# Dedicated token: full dataset READ incl private records; WRITE per ADR-0040
# (reference cleanup: owner-accepted Editor; other clones choose their own policy);
# asset ownership cannot itself be expressed by the role. Never NEXT_PUBLIC_.
CLIENT_GALLERY_CLEANUP=off
# SANITY_CLIENT_GALLERY_CLEANUP_TOKEN=
# CRON_SECRET=  # at least 16 characters; shared with other authenticated crons
# Optional validated bounds; exceeding a cap blocks cleanup visibly.
# CLIENT_GALLERY_CLEANUP_MAX_EXPORT_BYTES=67108864
# CLIENT_GALLERY_CLEANUP_MAX_DOCUMENTS=100000
# CLIENT_GALLERY_CLEANUP_EXPORT_TIMEOUT_MS=30000

# --- Proof pages (AB#130, ADR-0038) ---------------------------------------
#
# The read-only /client-proof/<handle> page for published proof galleries.
# Off by default with the same rules as CLIENT_GALLERY_ADAPTER: "sanity" needs
# SITE_CONTENT_SOURCE=sanity and a public dataset and is refused in Preview;
# "fixture" is local development/CI only. Selecting proofs is not built yet.
PROOF_GALLERY_ADAPTER=off

# --- Reserved namespaces of the removed protected gallery (AB#313) ---------
# The S3/Postgres protected client gallery (ADR-0014/0015) was removed under
# AB#313 on 2026-11-15/16. Every path under the two prefixes below, and under
# the literal /private-gallery and /private-gallery-admin segments, answers one
# empty 404 with no-store / noindex, nofollow / no-referrer.
#
# Root segments the former customer and administrator routes lived under
# (defaults "private" and "admin"). Each is one lowercase segment, must differ
# from the other, and must not collide with a locale prefix, the redundant
# default-locale prefix, a story namespace, a legacy-redirect root or an
# existing route — a collision fails the build. Leave unset unless an old
# deployment used custom values whose links should keep answering 404.
# PRIVATE_GALLERY_ROUTE_PREFIX=private
# PRIVATE_GALLERY_ADMIN_ROUTE_PREFIX=admin
#
# PRIVATE_GALLERY_STORE is accepted only unset or "off"; any other value
# ("enabled", "memory", ...) fails the build and asks for it to be removed.
# Every other PRIVATE_GALLERY_* setting (database URL, S3 endpoint and
# credentials, capability keyring, administrator secret hash, notification
# adapter) is no longer read: delete it from local and hosted environments.
# A NEXT_PUBLIC_ mirror of a formerly secret one still fails the build.

# ADR-0028 legacy continuity: retained unlisted delivery galleries.
# Off until an approved import, notice/usage/recovery checks and link verification.
LEGACY_GALLERY_ADAPTER=off
# Sanity mode also requires SITE_CONTENT_SOURCE=sanity, the exact approved
# 64-character batch digest and a comma-separated list of deployed 32-hex handles.
# Handles are publication guards, not passwords; the assets/pages are public.
# Sanity selection is refused in Preview (declared stage or Vercel platform).
LEGACY_GALLERY_IMPORT_BATCH=
LEGACY_GALLERY_HANDLES=
# fixture is local-development-only (explicit stage, no Vercel Preview/Production).

# Optional owner-local exact source/handle pairs, serialized as a JSON array.
# Keep real legacy customer paths outside Git and Preview. Used only while
# the retained-gallery adapter is enabled; targets must be allowlisted handles.
# GET/HEAD use a temporary 307, drop historical query values, and retain only a
# validated non-default UI locale. Reserved namespaces/public mappings take precedence.
# An invalid map disables retained redirects while ordinary public routes continue.
LEGACY_GALLERY_REDIRECTS=

# Proof gallery publication route (AB#130, ADR-0038 amendment 2026-10-22).
# Off unless "enabled". The Studio publish action calls it with the editor's own
# Sanity token; every Sanity read and write uses that token, so this route holds
# no write credential. Do not enable before the terms and Studio-action slices.
# PROOF_PUBLICATION=enabled
# Exact https origins of the Studio that may call the route, comma-separated
# (at most five; http://localhost only when NODE_ENV=development).
# PROOF_PUBLICATION_STUDIO_ORIGINS=https://example.sanity.studio
# 32 random bytes as base64url, server-only: encrypts the stored copy of each
# selection key. Never set a NEXT_PUBLIC_ variant. Generate with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# PROOF_SELECTION_KEY_SECRET=

# Proof selection route (AB#130, ADR-0038 decision 5). Off unless "enabled";
# needs PROOF_GALLERY_ADAPTER=sanity. The customer's selection key from the link
# fragment is checked against its hash; writes go to private dotted IDs.
# Do not enable before the photographer notice exists. "fixture" is the
# harness's synthetic store, refused outside local development.
# PROOF_SELECTION=enabled
# Server-only Sanity token that reads and writes the private proof records
# (proofTerms.*, proofSelection.*, proofNotice.*). Revocable on its own; never
# a NEXT_PUBLIC_ variant (that makes the route unavailable).
# SANITY_PROOF_SELECTION_TOKEN=

# Daily customer reminders (AB#130, ADR-0038 decision 9). Off unless "enabled";
# needs PROOF_SELECTION=enabled, PROOF_SELECTION_KEY_SECRET and the contact
# delivery settings (the reminder's Reply-To is CONTACT_DELIVERY_TO). Vercel's
# cron (vercel.json) calls /api/proof-reminders daily with CRON_SECRET; set a
# random value of at least 16 characters, never a NEXT_PUBLIC_ variant. Do not
# enable before the privacy notice names the reminder.
# PROOF_REMINDERS=enabled
# CRON_SECRET=
