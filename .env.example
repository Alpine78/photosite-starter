# Default locale: BCP 47 tag with a concrete language subtag, used by the root
# language attribute, date formatting, and the unprefixed public routes.
SITE_LOCALE=en-GB

# Public route space per supported locale: comma-separated
# "locale|prefix|namespace" entries. The default locale leaves the prefix empty,
# because its routes carry none, and must match SITE_LOCALE. Every other locale
# needs a unique prefix that no root route already owns. A story namespace may
# not shadow a localized static route. A bilingual deployment with unprefixed
# Finnish and prefixed English reads: fi||tarinat,en|en|stories
SITE_LOCALE_ROUTES=en-GB||stories

# Public origin every canonical and Open Graph URL is built from. Bare origin
# only: no credentials, query, fragment, or path.
SITE_CANONICAL_BASE_URL=https://example.com

# Versioned public web derivative: a local /gallery path or an HTTPS URL. It
# crosses the same public media boundary as every other browser-facing image.
SITE_DEFAULT_SOCIAL_IMAGE=/gallery/coastal-landscape.1683eecb7e65.webp

# Byte version contained in SITE_DEFAULT_SOCIAL_IMAGE. Required only for a
# remote URL; a local /gallery path already carries it in the filename.
# SITE_DEFAULT_SOCIAL_IMAGE_VERSION=

# True intrinsic pixel dimensions of SITE_DEFAULT_SOCIAL_IMAGE. Nothing in the
# application can measure a deployment-owned file, so they are declared here.
SITE_DEFAULT_SOCIAL_IMAGE_WIDTH=1536
SITE_DEFAULT_SOCIAL_IMAGE_HEIGHT=1024

# Optional alt text for the default social image. Left unset, no og:image:alt is
# emitted rather than an invented description.
SITE_DEFAULT_SOCIAL_IMAGE_ALT=Rocky shoreline beside calm water under an overcast sky
